{
  "app": "tiendi-api",
  "files": {
    "runtime": "runtime.json",
    "integrations": "integrations.json"
  },
  "heartbeat": "heartbeat.json",
  "required": [
    "DATABASE_URL",
    "JWT_SECRET",
    "JWT_REFRESH_SECRET",
    "METRICS_SECRET"
  ],
  "optional": [
    "CULQI_SECRET_KEY",
    "CULQI_WEBHOOK_SECRET",
    "CLOUDINARY_API_SECRET",
    "SENDGRID_API_KEY",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASS",
    "MAIL_FROM",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_VERIFY_SERVICE_SID",
    "FIREBASE_CLIENT_EMAIL",
    "FIREBASE_PRIVATE_KEY",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_MAPS_API_KEY",
    "PAYOUT_BANK_NAME",
    "PAYOUT_BANK_HOLDER_NAME",
    "PAYOUT_BANK_ACCOUNT_NUMBER",
    "PAYOUT_BANK_CCI",
    "SHIELD_JWT_SECRET",
    "SHIELD_SERVICE_TOKEN",
    "KIPU_SERVICE_TOKEN"
  ],
  "env": {
    "DATABASE_URL":               ["runtime", "DATABASE_URL"],
    "JWT_SECRET":                 ["runtime", "JWT_SECRET"],
    "JWT_REFRESH_SECRET":         ["runtime", "JWT_REFRESH_SECRET"],
    "METRICS_SECRET":             ["runtime", "METRICS_SECRET"],
    "CULQI_SECRET_KEY":           ["runtime", "CULQI_SECRET_KEY"],
    "CULQI_WEBHOOK_SECRET":       ["runtime", "CULQI_WEBHOOK_SECRET"],
    "CLOUDINARY_API_SECRET":      ["runtime", "CLOUDINARY_API_SECRET"],
    "SENDGRID_API_KEY":           ["runtime", "SENDGRID_API_KEY"],
    "SMTP_HOST":                  ["runtime", "SMTP_HOST"],
    "SMTP_PORT":                  ["runtime", "SMTP_PORT"],
    "SMTP_USER":                  ["runtime", "SMTP_USER"],
    "SMTP_PASS":                  ["runtime", "SMTP_PASS"],
    "MAIL_FROM":                  ["runtime", "MAIL_FROM"],
    "TWILIO_ACCOUNT_SID":         ["runtime", "TWILIO_ACCOUNT_SID"],
    "TWILIO_AUTH_TOKEN":          ["runtime", "TWILIO_AUTH_TOKEN"],
    "TWILIO_VERIFY_SERVICE_SID":  ["runtime", "TWILIO_VERIFY_SERVICE_SID"],
    "FIREBASE_CLIENT_EMAIL":      ["runtime", "FIREBASE_CLIENT_EMAIL"],
    "FIREBASE_PRIVATE_KEY":       ["runtime", "FIREBASE_PRIVATE_KEY"],
    "GOOGLE_CLIENT_SECRET":       ["runtime", "GOOGLE_CLIENT_SECRET"],
    "GOOGLE_MAPS_API_KEY":        ["runtime", "GOOGLE_MAPS_API_KEY"],
    "PAYOUT_BANK_NAME":           ["runtime", "PAYOUT_BANK_NAME"],
    "PAYOUT_BANK_HOLDER_NAME":    ["runtime", "PAYOUT_BANK_HOLDER_NAME"],
    "PAYOUT_BANK_ACCOUNT_NUMBER": ["runtime", "PAYOUT_BANK_ACCOUNT_NUMBER"],
    "PAYOUT_BANK_CCI":            ["runtime", "PAYOUT_BANK_CCI"],
    "SHIELD_JWT_SECRET":          ["runtime", "SHIELD_JWT_SECRET"],
    "SHIELD_SERVICE_TOKEN":       ["integrations", "shield.service_token"],
    "KIPU_SERVICE_TOKEN":         ["integrations", "tiendi-kipu.service_token"]
  }
}