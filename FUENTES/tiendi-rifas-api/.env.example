# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database (Dedicated PostgreSQL for Raffles)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rifas?schema=public"

# Redis (BullMQ queue & locks)
REDIS_URL="redis://localhost:6379"

# drand Randomness Beacon
DRAND_CHAIN_HASH=52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971
DRAND_RELAYS=https://api.drand.sh,https://api2.drand.sh,https://drand.cloudflare.com

# Seed Vault / Encryption (OpenBao / KMS secret reference)
SEED_ENCRYPTION_KEY_REF=secret/data/rifas/seed-key

# Notifications (M2M integration with tiendi-notifications)
NOTIFICATIONS_URL=http://localhost:4001
NOTIFICATIONS_SERVICE_TOKEN=m2m-notifications-service-token

# Business Rules
RESERVATION_TTL_MINUTES=15
MAX_TICKETS_PER_RESERVATION=20
MAX_ACTIVE_RESERVED_PER_BUYER=20
PROOF_VERIFICATION_TTL_HOURS=12
PROOF_DEADLINE_MINUTES_BEFORE_CLOSE=120
PROOF_MAX_FILE_BYTES=5242880
PROOF_STORAGE_DIR=./storage/proofs

# JWT Authentication
JWT_SECRET=local-jwt-secret-for-rifas-min-32-chars-long
JWT_EXPIRES_IN=7d
