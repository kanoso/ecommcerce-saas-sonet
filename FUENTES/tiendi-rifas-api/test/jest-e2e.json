{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "testTimeout": 60000,
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.e2e.json"
      }
    ]
  },
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/global-setup-integration.ts",
  "setupFiles": [
    "<rootDir>/setup-e2e.ts"
  ]
}
